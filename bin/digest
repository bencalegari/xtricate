#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "fileutils"

ROOT = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(ROOT, "lib"))

# Load .env for local/dry runs. In CI, secrets come from the environment, and
# dotenv simply finds no file — harmless.
begin
  require "dotenv"
  Dotenv.load(File.join(ROOT, ".env"))
rescue LoadError
  # dotenv not installed (e.g. production-only bundle) — env must be preset.
end

require "xtricate"

options = {
  mode: :full,
  out: File.join(ROOT, "digest.html"),
  out_dir: nil,
  limit: nil,
  subscribers: nil,
  only: nil,
  verbose: false
}

parser = OptionParser.new do |o|
  o.banner = "Usage: bin/digest [options]"
  o.on("--dry-run", "Render each digest to an HTML file instead of emailing") { options[:mode] = :dry_run }
  o.on("--fetch-only", "Fetch + print a summary; skip Claude and email") { options[:mode] = :fetch_only }
  o.on("--limit N", Integer, "Only process the first N accounts per subscriber (for testing)") { |n| options[:limit] = n }
  o.on("--out FILE", "Output path for --dry-run with a single subscriber (default: digest.html)") { |f| options[:out] = f }
  o.on("--out-dir DIR", "Directory for --dry-run output when there are several subscribers") { |d| options[:out_dir] = d }
  o.on("--subscribers FILE", "YAML subscriber list (default: subscribers.local.yml, else the XTRICATE_SUBSCRIBERS secret)") { |f| options[:subscribers] = f }
  o.on("--only ID_OR_EMAIL", "Run for a single subscriber (id like subscriber-2, or their email)") { |s| options[:only] = s }
  o.on("--verbose", "Print handles and recipient addresses (never use in CI: public logs)") { options[:verbose] = true }
  o.on("-h", "--help", "Show this help") { puts o; exit }
end
parser.parse!(ARGV)

log = $stdout
config = Xtricate::Config.load(root: ROOT)
ENV["TZ"] = config.timezone

resolution = Xtricate::SubscriberSource.resolve(
  config: config, root: ROOT, path: options[:subscribers], logger: log
)
subscribers = resolution.subscribers

if options[:only]
  wanted = options[:only].strip.downcase
  subscribers = subscribers.select { |s| s.id == wanted || s.email.downcase == wanted }
  abort "No subscriber matches #{options[:only].inspect}." if subscribers.empty?
end

if options[:limit]
  subscribers = subscribers.map do |s|
    s.dup.tap do |c|
      c.accounts = c.accounts.first(options[:limit])
      c.bluesky_accounts = c.bluesky_accounts.first(options[:limit])
    end
  end
end

verbose = options[:verbose] && !ENV["GITHUB_ACTIONS"]

twitter_handles = subscribers.flat_map(&:accounts).uniq
bluesky_handles = subscribers.flat_map(&:bluesky_accounts).uniq
config.validate!(mode: options[:mode], needs_twitter: twitter_handles.any?)

max_lookback = subscribers.map(&:lookback_days).max
fetch_since = Time.now - (max_lookback * 24 * 60 * 60)

reply_handles = subscribers.select(&:include_replies).flat_map(&:accounts).map(&:downcase).uniq

log.puts "Xtricate: #{subscribers.size} subscriber(s), #{twitter_handles.size} Twitter + #{bluesky_handles.size} Bluesky account(s), looking back up to #{max_lookback} days."
log.puts "Fetching replies for #{reply_handles.size} of #{twitter_handles.size} Twitter account(s)." if twitter_handles.any?

# --- Fetch once for everyone (Twitter + Bluesky in parallel) ------------------
activities = []

twitter_thread = nil
if twitter_handles.any?
  twitter_fetcher = Xtricate::Fetch.new(
    api_key: config.twitterapi_key,
    since: fetch_since,
    max_per_account: config.max_tweets_per_account,
    reply_handles: reply_handles,
    qps: config.fetch_qps,
    logger: log
  )
  twitter_thread = Thread.new do
    log.puts "Fetching from twitterapi.io..."
    twitter_fetcher.fetch_all(twitter_handles)
  end
end

bluesky_thread = nil
if bluesky_handles.any?
  bluesky_fetcher = Xtricate::BlueskyFetch.new(
    since: fetch_since,
    max_per_account: config.max_tweets_per_account,
    qps: config.fetch_qps,
    logger: log
  )
  bluesky_thread = Thread.new do
    log.puts "Fetching from Bluesky..."
    bluesky_fetcher.fetch_all(bluesky_handles)
  end
end

activities.concat(twitter_thread.value) if twitter_thread
activities.concat(bluesky_thread.value) if bluesky_thread

total = activities.sum { |a| (a.tweets || []).size }
fetch_failures = (twitter_fetcher&.failures || []) + (bluesky_fetcher&.failures || [])
fetch_attempted = twitter_handles.size + bluesky_handles.size
systemic_fetch_failure = fetch_failures.size > (fetch_attempted * 0.1)
log.puts "Fetched #{total} post(s) across #{activities.count { |a| !a.empty? }} active account(s)."
if fetch_failures.any?
  log.puts "#{fetch_failures.size} of #{fetch_attempted} account(s) could not be fetched and are missing from this run#{verbose ? ": #{fetch_failures.join(', ')}" : ''}."
end

if options[:mode] == :fetch_only
  subscribers.each do |sub|
    slice = Xtricate::ActivitySlice.for(sub, activities)
    posts = slice.sum { |a| a.tweets.size }
    log.puts "\n[#{sub.id}] #{posts} post(s) across #{slice.count { |a| !a.empty? }} active account(s)."
    next unless verbose

    slice.each do |a|
      next if a.empty?

      src_tag = a.source == :bluesky ? "bsky" : "x"
      log.puts "  [#{src_tag}] @#{a.handle} — #{a.tweets.size} post(s):"
      a.tweets.first(5).each do |t|
        tag = t.kind == :original ? "" : "[#{t.kind}] "
        thread = t.thread_head? ? "[thread+#{(t.thread_continuations || []).size}] " : ""
        mt = t.media && !t.media.empty? ? " (#{t.media.size}img)" : ""
        links = t.urls.empty? ? "" : "  (#{t.urls.size} link#{'s' if t.urls.size != 1})"
        log.puts "    #{tag}#{thread}#{(t.text.empty? ? "(no commentary)" : t.text[0, 120])}#{mt}#{links}"
      end
    end
  end
  log.puts "\nfetch-only done."
  exit 0
end

if options[:mode] == :dry_run && options[:out_dir]
  FileUtils.mkdir_p(options[:out_dir])
end

# --- Summarize, render, and send per subscriber -------------------------------
og_fetcher = Xtricate::OgFetch.new(logger: verbose ? log : nil)
mailer =
  if options[:mode] == :full
    Xtricate::Mailer.new(
      gmail_address: config.gmail_address,
      gmail_app_password: config.gmail_app_password,
      sender_name: config.sender_name
    )
  end

failures = []
skipped = 0

subscribers.each do |sub|
  slice = Xtricate::ActivitySlice.for(sub, activities)
  posts = slice.sum { |a| a.tweets.size }

  if posts.zero?
    log.puts "[#{sub.id}] no posts in their #{sub.lookback_days}-day window — skipping."
    skipped += 1
    next
  end

  digest = Xtricate::Digest.new(
    api_key: config.anthropic_key,
    model: config.model,
    since: sub.since,
    lookback_days: sub.lookback_days,
    preferred_outlets: config.preferred_long_form_outlets,
    max_solo_picks: sub.max_solo_picks,
    max_payload_tweets: sub.max_payload_tweets,
    payload_tweets_per_account: sub.payload_tweets_per_account,
    max_discoveries: sub.max_discoveries,
    og_fetcher: og_fetcher,
    logger: log
  )
  result = digest.build(slice)

  renderer = Xtricate::Renderer.new(timezone: sub.timezone)
  parts = renderer.parts(result)
  subject = renderer.subject(result)
  sizes = parts.map { |p| renderer.encoded_size(p) }

  if options[:mode] == :dry_run
    base =
      if options[:out_dir]
        File.join(options[:out_dir], "digest-#{sub.id}.html")
      elsif subscribers.size == 1
        options[:out]
      else
        File.join(ROOT, "digest-#{sub.id}.html")
      end
    written = parts.each_with_index.map do |html, i|
      path = parts.size == 1 ? base : base.sub(/(\.html)?\z/, "-#{i + 1}\\1")
      File.write(path, html)
      path
    end
    log.puts "[#{sub.id}] wrote #{written.join(', ')} (#{posts} post(s), #{result.themes.size} theme(s), #{result.solo_picks.size} solo pick(s), #{parts.size} part(s), #{sizes.join('+')} encoded bytes). Subject: #{subject.inspect}"
    next
  end

  sent_parts, part_failures = mailer.deliver_parts(to: sub.email, subject: subject, parts: parts)
  if part_failures.any?
    failures << [sub.id, "delivered #{sent_parts}/#{parts.size} part(s); #{part_failures.join('; ')}"]
    log.puts "[#{sub.id}] PARTIAL — delivered #{sent_parts} of #{parts.size} part(s): #{part_failures.join('; ')}"
  else
    log.puts "[#{sub.id}] sent — #{posts} post(s), #{result.themes.size} theme(s), #{parts.size} part(s)#{verbose ? " → #{sub.email}" : ''}."
  end
rescue StandardError => e
  failures << [sub.id, "#{e.class}: #{e.message}"]
  log.puts "[#{sub.id}] FAILED — #{e.class}: #{e.message}"
end

resolution.failures.each { |id, msg| log.puts "#{id} could not be loaded: #{msg}" }

sent = subscribers.size - failures.size - skipped
log.puts "Done: #{sent} delivered, #{skipped} empty, #{failures.size} failed, #{fetch_failures.size} account(s) unfetched."
exit 1 if failures.any? || resolution.failures.any? || systemic_fetch_failure
