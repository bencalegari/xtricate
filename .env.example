# Copy to .env and fill in. .env is gitignored.
#
# API keys only. Personal settings — who you follow, where the digest goes —
# live in subscribers.local.yml locally and in subscriber gists in CI. See
# subscribers.example.yml and the README.

# twitterapi.io — dashboard -> API Key (https://twitterapi.io)
TWITTERAPI_IO_KEY=

# Anthropic — console.anthropic.com -> Settings -> API Keys (starts with sk-ant-)
ANTHROPIC_API_KEY=

# Gmail sender (only needed for live email, not for --dry-run)
# Generate an App Password: myaccount.google.com -> Security -> App passwords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Subscriber roster: "email|gist_url", comma- or newline-separated. This is what
# the GitHub Action reads; locally, subscribers.local.yml takes precedence.
# XTRICATE_SUBSCRIBERS="
# you@example.com|https://gist.github.com/you/6f1c0b9e2d3a4b5c6d7e8f90
# friend@example.com|https://gist.github.com/friend/9ab3c2d1e0f9a8b7c6d5e4f3
# "
XTRICATE_SUBSCRIBERS=
